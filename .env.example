DB_NAME=erp_assistant
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root

# Mac : Ollama natif sur l'hôte. Linux avec le profil ollama-docker : http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Fournisseur de LLM pour la génération : anthropic, groq (gratuit), mistral ou ollama (local)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OLLAMA_CHAT_MODEL=llama3.2:3b
# Recherche : vector, hybrid (vecteurs + plein texte, RRF) ou hybrid_rerank (+ reclassement par LLM via Groq)
RETRIEVAL_MODE=hybrid_rerank
RERANK_MODEL=qwen/qwen3.8-27b
LANGFUSE_SECRET_KEY="sk-lf-c2a41702-668b-45cc-880e-d26bea841075"
LANGFUSE_PUBLIC_KEY="pk-lf-12eed830-ed86-4b76-8b18-f516a7331d0c"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# Traces Langfuse (facultatif : désactivé sans clés). Région UE : https://cloud.langfuse.com, États-Unis : https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
